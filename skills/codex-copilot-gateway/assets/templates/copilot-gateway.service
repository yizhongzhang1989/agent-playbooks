[Unit]
Description=Local authenticated Copilot API gateway for Codex
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/codex-copilot
ExecStart=%h/.local/bin/copilot-gateway start --host 127.0.0.1 --port 4141
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
