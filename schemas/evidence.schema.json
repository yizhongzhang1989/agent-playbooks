{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "scope", "environment", "material_hashes", "checks", "limitations"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scope": { "enum": ["source_installation", "repository_offline", "target_installation"] },
    "environment": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "material_hashes": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "method", "source_refs", "detail"],
        "properties": {
          "id": { "type": "string", "pattern": "^A_[A-Z0-9_]+$" },
          "result": { "enum": ["passed", "failed", "not_tested"] },
          "method": { "enum": ["offline", "local", "live", "user", "manual"] },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
