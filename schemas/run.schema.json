{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "skill_id",
    "skill_revision",
    "operation",
    "status",
    "completed_steps",
    "pending_step",
    "required_checks",
    "artifact_refs",
    "resume_checks",
    "context",
    "feedback"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "waiting_for_user",
        "blocked",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "completed_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "pending_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "passed",
          "failed",
          "not_tested"
        ]
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "environment"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "finding_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "pending",
            "recorded"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "finding_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "none",
                  "pending"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "finding_ids": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "pending_step": {
            "type": "null"
          },
          "required_checks": {
            "type": "object",
            "additionalProperties": {
              "const": "passed"
            }
          }
        }
      }
    }
  ]
}
