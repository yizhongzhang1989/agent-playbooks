{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "kind",
        "summary",
        "observed_on",
        "applies_to",
        "operations",
        "blocking",
        "aliases",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "dismissed"
          ]
        },
        "kind": {
          "enum": [
            "problem",
            "discovery"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "observed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "resources",
            "verification"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "resources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "verification": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "result",
                  "detail"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "offline",
                      "local",
                      "live",
                      "user",
                      "manual"
                    ]
                  },
                  "result": {
                    "const": "passed"
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "resolved",
                  "dismissed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "resolution"
            ],
            "properties": {
              "resolution": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "open"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "resolution"
              ],
              "properties": {
                "resolution": {}
              }
            }
          }
        }
      ]
    }
  }
}
